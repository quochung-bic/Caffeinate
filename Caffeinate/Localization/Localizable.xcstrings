{
  "sourceLanguage": "vi",
  "strings": {
    "%@ đang chạy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running"
          }
        }
      }
    },
    "%@ — không tìm thấy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — not found"
          }
        }
      }
    },
    "%@, không tìm thấy trên máy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, not found on this Mac"
          }
        }
      }
    },
    "%lld phút": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes"
                }
              }
            }
          }
        }
      }
    },
    "%lldh": {
      "comment": "Nhãn nút thời lượng, tính bằng giờ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldh"
          }
        }
      }
    },
    "%lldp": {
      "comment": "Nhãn nút thời lượng, tính bằng phút",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldm"
          }
        }
      }
    },
    "Bấm \"Tắt\" để dừng ngay, kể cả khi đang có luật tự động chạy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Stop\" to end it right away, even while an automatic rule is running."
          }
        }
      }
    },
    "Bấm icon ly cà phê trên thanh menu để mở bảng điều khiển.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the coffee cup in the menu bar to open the control panel."
          }
        }
      }
    },
    "Bật không giới hạn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on indefinitely"
          }
        }
      }
    },
    "Bật sẵn ngay khi app khởi chạy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on as soon as the app starts"
          }
        }
      }
    },
    "Bật thủ công": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned on manually"
          }
        }
      }
    },
    "Bật trong %lld phút": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn on for %lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn on for %lld minutes"
                }
              }
            }
          }
        }
      }
    },
    "Caffeinate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate"
          }
        }
      }
    },
    "Caffeinate báo bằng ba đường độc lập — banner thông báo, một tiếng chuông, và icon nhấp nháy — vì đường nào cũng có lúc câm: banner bị Do Not Disturb chặn, âm thanh vô nghĩa khi tai nghe ở phòng khác, còn icon thì chỉ thấy nếu đang nhìn lên thanh menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate tells you three independent ways — a notification banner, one chime, and a blinking menu bar icon — because any single one of them can go silent: banners get blocked by Do Not Disturb, sound is useless when your headphones are in another room, and the icon only helps if you happen to be looking at the menu bar."
          }
        }
      }
    },
    "Caffeinate gặp lỗi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate hit an error"
          }
        }
      }
    },
    "Caffeinate đang bật, còn %lld phút": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Caffeinate is on, %lld minute left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Caffeinate is on, %lld minutes left"
                }
              }
            }
          }
        }
      }
    },
    "Caffeinate đang bật, không giới hạn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate is on, indefinitely"
          }
        }
      }
    },
    "Caffeinate đang tắt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate is off"
          }
        }
      }
    },
    "Caffeinate đã tắt. Máy có thể ngủ như bình thường.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate turned off. Your Mac can sleep normally again."
          }
        }
      }
    },
    "Chung": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "Chưa có app nào. Thêm app để Caffeinate tự bật khi app đó chạy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps yet. Add one and Caffeinate turns on whenever it’s running."
          }
        }
      }
    },
    "Chọn \"Không giới hạn\" nếu chưa biết cần bao lâu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Indefinite\" when you don’t know how long you’ll need it."
          }
        }
      }
    },
    "Chọn một mốc thời gian — hết giờ là máy tự trở về bình thường.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a duration — when it runs out, your Mac goes back to normal on its own."
          }
        }
      }
    },
    "Cài đặt…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "còn lại": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "left"
          }
        }
      }
    },
    "Có màn hình ngoài": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An external display is connected"
          }
        }
      }
    },
    "Cần bật \"Khởi động cùng macOS\" trước — nếu app không tự chạy lúc đăng nhập thì tuỳ chọn kia không có tác dụng.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Launch at login\" first — if the app doesn’t start when you log in, that option has no effect."
          }
        }
      }
    },
    "Dùng thế nào": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use it"
          }
        }
      }
    },
    "Giao diện": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "Giao diện đổi ngay. Các hộp thoại do macOS vẽ hộ — chọn app, xin quyền thông báo — sẽ đổi từ lần mở app sau.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface changes right away. Dialogs macOS draws on the app’s behalf — picking an app, asking for notification permission — change from the next launch."
          }
        }
      }
    },
    "Giới thiệu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "Giữ cho máy khỏi ngủ, khi nào bạn muốn.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your Mac awake, for exactly as long as you want."
          }
        }
      }
    },
    "Hẹn giờ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer"
          }
        }
      }
    },
    "Hẹn giờ đã xong, nhưng một luật tự động vẫn đang giữ máy thức.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer finished, but an automatic rule is still keeping your Mac awake."
          }
        }
      }
    },
    "Hết giờ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time’s up"
          }
        }
      }
    },
    "Hệ thống": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
    "Idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle"
          }
        }
      }
    },
    "Khi Caffeinate bật, giữ những gì": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to hold while Caffeinate is on"
          }
        }
      }
    },
    "Khi hết giờ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the timer runs out"
          }
        }
      }
    },
    "Không bật được khởi động cùng macOS: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t turn on launch at login: %@"
          }
        }
      }
    },
    "Không giới hạn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indefinite"
          }
        }
      }
    },
    "không giới hạn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "indefinite"
          }
        }
      }
    },
    "không giữ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not held"
          }
        }
      }
    },
    "Không giữ được máy thức: hệ thống từ chối %@ (mã %d). Caffeinate đã tắt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t keep your Mac awake: the system refused %@ (code %d). Caffeinate turned off."
          }
        }
      }
    },
    "Không gỡ được %@ (mã %d). Máy vẫn đang được giữ thức đúng như bạn yêu cầu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t release %@ (code %d). Your Mac is still being kept awake exactly as you asked."
          }
        }
      }
    },
    "Không tắt được khởi động cùng macOS: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t turn off launch at login: %@"
          }
        }
      }
    },
    "Không đổi được cài đặt khởi động: app phải nằm trong thư mục /Applications. Hiện tại đang chạy từ %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t change the startup setting: the app must live in /Applications. It’s currently running from %@."
          }
        }
      }
    },
    "Khởi động": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        }
      }
    },
    "Khởi động cùng macOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        }
      }
    },
    "Ly đầy khi vừa bật và vơi dần theo đồng hồ đếm ngược. Cùng một hình đó thu nhỏ thành icon trên thanh menu, nên liếc một cái là biết còn bao lâu mà không cần mở gì.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cup is full the moment you turn it on and drains as the countdown runs. The same shape, shrunk down, is the menu bar icon — so one glance tells you how much is left without opening anything."
          }
        }
      }
    },
    "Lỗi không xác định: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected error: %@"
          }
        }
      }
    },
    "Màn hình": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "Màn hình không tắt. Tốn pin — chỉ bật khi cần nhìn liên tục.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display never turns off. Costs battery — only turn it on when you need to keep watching the screen."
          }
        }
      }
    },
    "Máy không tính là bạn đang rảnh tay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac won’t count you as idle."
          }
        }
      }
    },
    "Máy không tự vào chế độ ngủ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac won’t go to sleep on its own."
          }
        }
      }
    },
    "Mặc định chỉ giữ hệ thống. Đó thường là thứ duy nhất bạn cần.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System only, by default. That’s usually the only one you need."
          }
        }
      }
    },
    "Mốc này xuất hiện thành nút thứ tư trên panel, cạnh 15p / 30p / 1h.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shows up as the fourth button in the panel, next to 15m / 30m / 1h."
          }
        }
      }
    },
    "Một app trong danh sách đang chạy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app from the list is running"
          }
        }
      }
    },
    "Mực cà phê là thanh tiến trình": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coffee level is the progress bar"
          }
        }
      }
    },
    "Ngôn ngữ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "Nút Tắt luôn thắng: nó gỡ cả những luật đang đúng. Một luật chỉ bật lại khi điều kiện của nó thật sự tái diễn — rút sạc rồi cắm lại, chứ không phải vài giây sau đó.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop always wins: it clears even the rules that are currently true. A rule only comes back when its condition genuinely happens again — unplug and plug back in, not a few seconds later."
          }
        }
      }
    },
    "Phiên bản %@ (%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        }
      }
    },
    "Theo hệ thống": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow system"
          }
        }
      }
    },
    "Thoát": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "Thêm app…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add app…"
          }
        }
      }
    },
    "Thời lượng tuỳ chỉnh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom duration"
          }
        }
      }
    },
    "Tắt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "Tự bật khi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on automatically when"
          }
        }
      }
    },
    "Tự động": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        }
      }
    },
    "Xoá": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Đang bật, hẹn giờ tới %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, timer until %@"
          }
        }
      }
    },
    "Đang bật, không giới hạn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, indefinitely"
          }
        }
      }
    },
    "Đang cắm sạc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugged into power"
          }
        }
      }
    },
    "đang giữ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "held"
          }
        }
      }
    },
    "Đang tắt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "đang tắt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
