// App.xcconfig — settings specific to the application target.
// Everything shared (platform, Swift, warnings) lives in
// Base/Debug/Release.xcconfig, applied at the project level.

// MARK: - Identity
//
// The bundle ID has to be reverse-DNS of a domain you actually control.
// io.github.<user> is a valid, stable convention for a project released through
// GitHub. Changing this changes both where UserDefaults lives and the login
// item registration, so it has to be settled BEFORE the first release and left
// alone afterwards.
PRODUCT_BUNDLE_IDENTIFIER = io.github.quochung-bic.Caffeinate
PRODUCT_NAME = Caffeinate

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Source of truth for the source language. All strings in code are English;
// the app ships in English only, with no String Catalog.
DEVELOPMENT_LANGUAGE = en

// MARK: - Info.plist (generated, so there is no separate plist to drift)

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Caffeinate
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 Quốc Hưng. MIT License.

// A menu bar app: no Dock icon, no entry in the App Switcher. This is a
// contract with the user — the app has to live entirely on the menu bar and
// must never depend on a window to function.
INFOPLIST_KEY_LSUIElement = YES

// MARK: - Resources

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
COMBINE_HIDPI_IMAGES = YES

// MARK: - Signing

// Hardened runtime is on so a local build matches a release build as closely as
// possible: anything the hardened runtime breaks then breaks on the developer's
// machine rather than after notarization.
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Configs/Caffeinate.entitlements
// "-" means ad-hoc signing. A real release needs "Developer ID Application".
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Automatic
